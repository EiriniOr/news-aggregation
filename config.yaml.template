# Weekly International Politics Digest Configuration

sources:
  # RSS feeds for international politics and war-related news
  rss_feeds:
    - url: "https://www.theguardian.com/world/rss"
      name: "The Guardian - World News"
    - url: "https://www.bbc.com/news/world/rss.xml"
      name: "BBC World News"
    - url: "https://www.aljazeera.com/xml/rss/all.xml"
      name: "Al Jazeera"
    - url: "https://www.reuters.com/rssFeed/worldNews"
      name: "Reuters World"
    - url: "https://feeds.washingtonpost.com/rss/world"
      name: "Washington Post - World"
    - url: "https://www.nytimes.com/svc/collections/v1/publish/https://www.nytimes.com/section/world/rss.xml"
      name: "New York Times - World"
    - url: "https://www.ft.com/world?format=rss"
      name: "Financial Times - World"
    - url: "https://www.economist.com/international/rss.xml"
      name: "The Economist - International"
